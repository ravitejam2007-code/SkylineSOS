# =====================================================================
# SkylineSOS — environment variable TEMPLATE (names only, no secrets)
# Copy to the files named below. NEVER commit real values.
# .gitignore must contain:  .env  .env.*  !.env.example  supabase/.env.local
# =====================================================================

# ---------------------------------------------------------------------
# 1) FRONTEND  ->  copy to  apps/web/.env      (Astro static build)
#    PUBLIC_ values are bundled into browser JS: only non-secret values.
# ---------------------------------------------------------------------
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=          # publishable/anon key (safe for browser, protected by RLS deny-all)
PUBLIC_API_BASE_URL=               # https://<project-ref>.supabase.co/functions/v1/api/v1
PUBLIC_APP_NAME=SkylineSOS

# ---------------------------------------------------------------------
# 2) API (Supabase Edge Function "api")
#    local : supabase/.env.local  (supabase functions serve api --env-file supabase/.env.local)
#    cloud : supabase secrets set --env-file supabase/.env.secrets
#    SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
#    automatically on hosted Supabase; set them only for local serving.
# ---------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # SERVER ONLY. Bypasses RLS. Never in apps/web, never in Git.
APP_ORIGIN=                        # exact frontend origin for CORS, e.g. https://skylinesos.pages.dev
RAZORPAY_KEY_ID=                   # Test Mode key id (rzp_test_...)
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test
CHECKOUT_TTL_MINUTES=15
MEMBER_CODE_TTL_SECONDS=60
LOG_LEVEL=info

# ---------------------------------------------------------------------
# 3) SEED / OPS SCRIPTS  ->  scripts/.env  (local machine only)
# ---------------------------------------------------------------------
SEED_SUPABASE_URL=
SEED_SERVICE_ROLE_KEY=
DEMO_ACCOUNT_PASSWORD=             # shared password for the 5 demo role accounts; give to judges out-of-band
