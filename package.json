{
  "name": "skylinesos",
  "version": "1.0.0",
  "private": true,
  "description": "Student Organization System for the Skyline Student Association",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "lint": "npm run --workspaces --if-present lint",
    "seed": "node scripts/seed.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3"
  }
}
