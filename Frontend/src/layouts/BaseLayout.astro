---
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';
import '../styles/transitions.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'SkylineSOS — Student Organization System',
  description = 'Skyline Student Association operating system: memberships, gala events, announcements, hoodies, fundraisers, and club finances.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full bg-[var(--color-canvas)]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ClientRouter />
  </head>
  <body class="min-h-full flex flex-col antialiased selection:bg-[var(--color-primary)] selection:text-white">
    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
