---
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/ui/Badge.astro';
import MembershipScene from '../components/scenes/MembershipScene';
---

<BaseLayout
  title="Skyline Student Association Memberships — SkylineSOS"
  description="Join the Skyline Student Association on SkylineSOS. Explore annual tiers, member benefits, discounts, and walk-up verification."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14">
    <!-- Header: Top Bold Text and Normal Text Down -->
    <div class="mb-8 md:mb-10 max-w-3xl">
      <h1 class="text-3xl sm:text-4xl lg:text-[40px] font-bold text-[#0f172a] tracking-tight leading-tight">
        Become a member of the Skyline Student Association.
      </h1>
      <p class="text-[15px] sm:text-base text-[#64748b] mt-2 font-normal leading-relaxed">
        Join self-service online or walk up to our campus table. Enjoy discounts on Spring Gala tickets, official club hoodies, and access to all club activities.
      </p>
    </div>

    <!-- Interactive Membership Scene Island -->
    <MembershipScene client:load />
  </div>
</BaseLayout>
