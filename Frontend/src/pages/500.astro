---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout
  title="500 — Server Operational Error · SkylineSOS"
  description="Transient server operational error on SkylineSOS."
>
  <div class="min-h-[calc(80vh-64px)] flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-xl w-full text-center space-y-6 t-enter">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[var(--color-surface-soft)] border border-[var(--color-hairline-soft)] text-[12px] font-bold text-[var(--color-steel)]">
        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
        HTTP 500 · Operational Server Error
      </div>

      <!-- Heading -->
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-[var(--color-ink-deep)]">
        Something Went Wrong
      </h1>

      <!-- Description -->
      <p class="text-[15px] sm:text-[16px] text-[var(--color-steel)] max-w-md mx-auto leading-relaxed">
        Our club backend encountered a transient operational exception. All audited database records, ticket allocations, and ledger balances remain secure.
      </p>

      <!-- Glassmorphic Diagnostic Card -->
      <div class="p-6 rounded-3xl glass-card border border-[var(--color-hairline-soft)] text-left space-y-3 shadow-xs">
        <div class="flex items-center justify-between text-[11px] font-mono font-bold text-[var(--color-steel)]">
          <span>DATA INTEGRITY CHECK</span>
          <span class="text-emerald-600 font-bold">✓ SECURED BY POSTGRES RLS</span>
        </div>
        <p class="text-[13px] text-[var(--color-ink)]">
          Zero missing cash or double-charged cards. Our deterministic transaction log guarantees that payment webhooks and member statuses are atomic.
        </p>
      </div>

      <!-- Action Navigation Buttons -->
      <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
        <Button variant="primary" size="md" href="/">
          Return to Homepage
        </Button>
        <button
          type="button"
          onclick="window.location.reload()"
          class="px-6 py-3 rounded-full border-2 border-[var(--color-ink-deep)] text-[var(--color-ink-deep)] text-[14px] font-bold hover:bg-black/5 transition-all cursor-pointer t-button-action"
        >
          ↻ Reload Page
        </button>
        <Button variant="ghost" size="md" href="/treasurer">
          View Treasury Status
        </Button>
      </div>
    </div>
  </div>
</BaseLayout>
