---
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/ui/Badge.astro';
import EventsScene from '../components/scenes/EventsScene';
---

<BaseLayout
  title="SkylineSOS — Spring Gala Tickets"
  description="Reserve tickets for the annual Skyline Spring Gala on SkylineSOS. Member and guest admission, live seat availability, and rapid check-in."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 space-y-12">
    <!-- Header -->
    <div class="max-w-3xl">
      <Badge variant="neutral" class="mb-3">Annual Gala 2026</Badge>
      <h1 class="text-4xl md:text-5xl font-medium text-[var(--color-ink-deep)] tracking-tight mb-4">
        Spring Gala: Masquerade Night
      </h1>
      <p class="text-lg text-[var(--color-steel)] font-light leading-relaxed">
        The club's flagship annual evening. Tiered ticket pricing for members and guests, real-time capacity reservations, and fast QR check-in at the door.
      </p>
    </div>

    <!-- Interactive Events Scene Island -->
    <EventsScene client:load />
  </div>
</BaseLayout>
