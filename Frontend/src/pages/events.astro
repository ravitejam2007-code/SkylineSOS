---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventsScene from '../components/scenes/EventsScene';
---

<BaseLayout
  title="Upcoming Organization Events — SkylineSOS"
  description="Select an event below to reserve passes. Active chapter members receive discounted rates."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14">
    <!-- Header matching Reference Design -->
    <div class="mb-8 md:mb-10 max-w-3xl">
      <h1 class="text-3xl sm:text-4xl lg:text-[40px] font-bold text-[#0f172a] tracking-tight leading-tight">
        Upcoming Organization Events
      </h1>
      <p class="text-[15px] sm:text-base text-[#64748b] mt-2 font-normal leading-relaxed">
        Select an event below to reserve passes. Active chapter members receive discounted rates.
      </p>
    </div>

    <!-- Interactive Events Scene Island -->
    <EventsScene client:load />
  </div>
</BaseLayout>
