---
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/ui/Badge.astro';
import FundraiserScene from '../components/scenes/FundraiserScene';
---

<BaseLayout
  title="SkylineSOS — Bake Sale Volunteering"
  description="Coordinate volunteer duty stations, split duties across baking, supplies, and quad table management, and track real-time task progress."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 space-y-12">
    <!-- Header -->
    <div class="max-w-3xl">
      <Badge variant="neutral" class="mb-3">Volunteer Operations</Badge>
      <h1 class="text-4xl md:text-5xl font-medium text-[var(--color-ink-deep)] tracking-tight mb-4">
        Spring Bake Sale Volunteering.
      </h1>
      <p class="text-lg text-[var(--color-steel)] font-light leading-relaxed">
        Coordinate volunteer duty stations across baking, supplies, and quad table management. Track real-time duties, submit progress updates, and pass feedback to admins.
      </p>
    </div>

    <!-- Interactive Volunteering Scene Island -->
    <FundraiserScene client:load />
  </div>
</BaseLayout>
