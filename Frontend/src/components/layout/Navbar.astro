---
import SearchPill from '../ui/SearchPill.astro';
import UserNavMenu from './UserNavMenu';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { label: 'Events', href: '/events' },
  { label: 'Memberships', href: '/memberships' },
  { label: 'Merch', href: '/merch' },
  { label: 'Fundraiser', href: '/fundraiser' },
  { label: 'Announcements', href: '/announcements' },
];
---

<header transition:persist="main-navbar" class="sticky top-0 z-50 w-full glass-navbar border-b border-black/[0.08] transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-[64px] flex items-center justify-between gap-4">
    <!-- Brand Wordmark -->
    <div class="flex items-center gap-3 shrink-0">
      <a href="/" class="flex items-center gap-2.5 group">
        <img
          src="/skylinesos-logo.jpg"
          alt="SkylineSOS Logo"
          class="w-8 h-8 rounded-full group-hover:scale-105 transition-transform shadow-xs shrink-0 object-cover border border-black/10"
        />
        <span class="font-extrabold text-[19px] tracking-tight text-[var(--color-ink-deep)]">
          SkylineSOS
        </span>
      </a>
    </div>

    <!-- Center Navigation Links (Clean, No Horizontal Scrollbars) -->
    <nav class="hidden md:flex items-center gap-1" id="desktop-nav">
      {
        navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              data-nav-link
              data-nav-href={item.href}
              class={`px-3.5 py-1.5 rounded-full text-[13px] font-bold tracking-tight transition-all duration-150 t-button-action ${
                isActive
                  ? 'bg-[var(--color-ink-deep)] text-white shadow-xs'
                  : 'text-[var(--color-steel)] hover:text-[var(--color-ink-deep)] hover:bg-black/5'
              }`}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Right Controls: Search & Interactive User Navigation Island -->
    <div class="flex items-center gap-3 shrink-0">
      <div class="hidden sm:block">
        <SearchPill id="search-pill-desktop" />
      </div>

      <!-- Reactive Auth & Persona Island -->
      <UserNavMenu client:load />

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-2 rounded-full text-[var(--color-ink-deep)] hover:bg-[var(--color-surface-soft)] transition-colors cursor-pointer"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer with Glassmorphism -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-[var(--color-hairline-soft)] glass-dropdown px-4 pt-3 pb-6 space-y-3">
    <div class="mb-2">
      <SearchPill id="search-pill-mobile" isExpandable={false} class="max-w-full w-full" />
    </div>
    <div class="flex flex-col gap-1" id="mobile-nav-links">
      {
        navItems.map((item) => {
          const isActive = currentPath === item.href;
          return (
            <a
              href={item.href}
              data-mobile-nav-link
              data-nav-href={item.href}
              class={`px-4 py-2.5 rounded-full text-[14px] font-bold transition-colors ${
                isActive
                  ? 'bg-[var(--color-ink-deep)] text-white'
                  : 'text-[var(--color-ink)] hover:bg-[var(--color-surface-soft)]'
              }`}
            >
              {item.label}
            </a>
          );
        })
      }
      <a
        href="/login"
        class="px-4 py-2.5 rounded-full text-[14px] font-bold text-[var(--color-ink)] hover:bg-[var(--color-surface-soft)] border border-[var(--color-hairline-soft)]"
      >
        Sign In / Switch Role
      </a>
    </div>
  </div>
</header>

<script>
  function setupNavbar() {
    const toggleBtn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const currentPath = window.location.pathname;

    // Sync Desktop Nav Active Classes
    const desktopLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
    desktopLinks.forEach((link) => {
      const href = link.getAttribute('data-nav-href');
      const isActive = href ? (currentPath === href || (href !== '/' && currentPath.startsWith(href))) : false;
      if (isActive) {
        link.className = 'px-3.5 py-1.5 rounded-full text-[13px] font-bold tracking-tight transition-all duration-150 t-button-action bg-[var(--color-ink-deep)] text-white shadow-xs';
      } else {
        link.className = 'px-3.5 py-1.5 rounded-full text-[13px] font-bold tracking-tight transition-all duration-150 t-button-action text-[var(--color-steel)] hover:text-[var(--color-ink-deep)] hover:bg-black/5';
      }
    });

    // Sync Mobile Nav Active Classes
    const mobileLinks = document.querySelectorAll<HTMLAnchorElement>('[data-mobile-nav-link]');
    mobileLinks.forEach((link) => {
      const href = link.getAttribute('data-nav-href');
      const isActive = href ? (currentPath === href || (href !== '/' && currentPath.startsWith(href))) : false;
      if (isActive) {
        link.className = 'px-4 py-2.5 rounded-full text-[14px] font-bold transition-colors bg-[var(--color-ink-deep)] text-white';
      } else {
        link.className = 'px-4 py-2.5 rounded-full text-[14px] font-bold transition-colors text-[var(--color-ink)] hover:bg-[var(--color-surface-soft)]';
      }
      // Clicking mobile link closes drawer
      link.addEventListener('click', () => {
        if (menu) {
          menu.classList.add('hidden');
          toggleBtn?.setAttribute('aria-expanded', 'false');
        }
      });
    });

    // Toggle button handler
    if (toggleBtn && menu) {
      // Remove any existing click listener to avoid duplicate toggles
      const newToggleBtn = toggleBtn.cloneNode(true) as HTMLElement;
      toggleBtn.parentNode?.replaceChild(newToggleBtn, toggleBtn);

      newToggleBtn.addEventListener('click', () => {
        const isHidden = menu.classList.toggle('hidden');
        newToggleBtn.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
      });
    }

    // Always ensure menu is closed after route navigation
    if (menu) {
      menu.classList.add('hidden');
      toggleBtn?.setAttribute('aria-expanded', 'false');
    }
  }

  // Hook into both initial load and Astro client-side page transitions
  document.addEventListener('astro:page-load', setupNavbar);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupNavbar);
  } else {
    setupNavbar();
  }
</script>
