---
import PublicLayout from "@/layouts/PublicLayout.astro";
import { VolunteerPortalPanel } from "@/islands/ops/VolunteerPortalPanel";
---

<PublicLayout title="Volunteer Portal — SkylineSOS">
  <div class="py-10 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="mb-6 flex items-center justify-between flex-wrap gap-4">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <a href="/" class="text-xs font-bold text-steel hover:text-ink">
            ← Home
          </a>
          <span class="text-steel text-xs">/</span>
          <span class="text-xs font-bold text-primary">Volunteer Operations</span>
        </div>
        <h1 class="text-3xl font-black text-ink-deep">Volunteer Squad Portal</h1>
      </div>
      <a
        href="/"
        class="px-4 py-2 rounded-full border border-hairline hover:border-ink-deep text-ink-deep font-bold text-xs bg-white transition-all shadow-xs"
      >
        Exit to Home
      </a>
    </div>

    <VolunteerPortalPanel client:load />
  </div>
</PublicLayout>
