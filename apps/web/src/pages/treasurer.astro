---
import PublicLayout from "@/layouts/PublicLayout.astro";
import { TreasurerLedger } from "@/islands/TreasurerLedger.tsx";
---

<PublicLayout title="Treasurer Ledger & Overview — SkylineSOS">
  <div class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="mb-8">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-success/10 text-success text-xs font-bold uppercase tracking-wider mb-2">
        <span class="w-1.5 h-1.5 rounded-full bg-success"></span>
        Treasury & Accounting
      </div>
      <h1 class="text-3xl font-black text-ink-deep">Club Financial Overview</h1>
      <p class="text-sm text-steel mt-1">
        Transparent ledger tracking all dues, ticket proceeds, merchandise sales, and approved expenses.
      </p>
    </div>

    <TreasurerLedger client:load />
  </div>
</PublicLayout>
