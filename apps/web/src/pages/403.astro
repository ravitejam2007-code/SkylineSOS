---
import PublicLayout from "@/layouts/PublicLayout.astro";
---

<PublicLayout title="Access Denied — SkylineSOS">
  <div class="py-24 px-4 text-center max-w-md mx-auto">
    <div class="w-16 h-16 rounded-full bg-critical/10 text-critical text-2xl font-black flex items-center justify-center mx-auto mb-4">
      403
    </div>
    <h1 class="text-2xl font-black text-ink-deep">Access Restricted</h1>
    <p class="text-sm text-steel mt-2 mb-6">
      Your current role does not have authorization to view this staff resource.
    </p>
    <a
      href="/"
      class="inline-flex px-6 py-2.5 rounded-full bg-ink-deep text-white font-bold text-sm hover:bg-charcoal transition-colors"
    >
      Return to Home
    </a>
  </div>
</PublicLayout>
