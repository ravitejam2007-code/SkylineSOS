---
import PublicLayout from "@/layouts/PublicLayout.astro";

const adminModules = [
  {
    title: "Door Verification",
    desc: "Single-screen check-in console with auto-detecting 6-digit & Crockford ticket code input.",
    link: "/door",
    icon: "🚪",
    badge: "Gate Ops"
  },
  {
    title: "Treasurer & Ledger",
    desc: "Source-linked financial records, net movement metrics, and expense approval queue.",
    link: "/treasurer",
    icon: "💰",
    badge: "Finance"
  },
  {
    title: "Digital Member Pass",
    desc: "Inspect rotating 60-second dynamic identity cards with real-time countdown ring.",
    link: "/membership/card",
    icon: "🪪",
    badge: "Identity"
  },
  {
    title: "Events & Ticket Sales",
    desc: "Manage published events, ticket categories, and live capacity constraints.",
    link: "/events",
    icon: "🎟️",
    badge: "Events"
  },
  {
    title: "Merchandise Store",
    desc: "Manage apparel inventory, stock reservations, and order fulfilment.",
    link: "/merch",
    icon: "👕",
    badge: "Merch"
  },
  {
    title: "Announcements",
    desc: "Broadcast official updates targeted to public, member, or staff audiences.",
    link: "/announcements",
    icon: "📢",
    badge: "Comms"
  }
];
---

<PublicLayout title="Staff Operations Console — SkylineSOS">
  <div class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="mb-10">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-ink-deep text-white text-xs font-bold uppercase tracking-wider mb-2">
        <span class="w-1.5 h-1.5 rounded-full bg-success"></span>
        Executive Board
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-ink-deep">Staff Operations Console</h1>
      <p class="text-sm text-steel mt-1">
        Command center for event gates, treasury, memberships, and club operations.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {adminModules.map((m) => (
        <a
          href={m.link}
          class="p-8 rounded-3xl bg-surface-soft hover:bg-white border border-hairline hover:border-ink-deep/30 transition-all flex flex-col justify-between shadow-xs hover:shadow-md group"
        >
          <div>
            <div class="flex justify-between items-start mb-4">
              <span class="text-3xl p-3 bg-white rounded-2xl border border-hairline shadow-xs group-hover:scale-105 transition-transform">
                {m.icon}
              </span>
              <span class="text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-white border border-hairline text-charcoal">
                {m.badge}
              </span>
            </div>
            <h2 class="text-xl font-bold text-ink-deep group-hover:text-primary transition-colors mb-2">
              {m.title}
            </h2>
            <p class="text-xs text-steel leading-relaxed">{m.desc}</p>
          </div>

          <div class="mt-6 pt-4 border-t border-hairline flex items-center justify-between text-xs font-bold text-ink">
            <span>Open Console</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</PublicLayout>
